---
import { ui } from '../i18n/ui';
const t = ui[Astro.locals.lang].tech;
---

<section class="px-6 pt-10 pb-[80px] lg:pt-12 lg:pb-[120px] xl:px-0">
	<div class="mx-auto flex max-w-[1320px] flex-col gap-16">
		<div class="flex flex-col gap-4">
			<p class="text-sm leading-5 font-semibold tracking-wider text-primary-500 uppercase">{t.eyebrow}</p>
			<h1 class="text-[40px] leading-[48px] font-semibold text-[#333] sm:text-5xl sm:leading-[56px]">{t.title}</h1>
			<p class="max-w-[760px] text-lg leading-7 text-gray-600">{t.intro}</p>
		</div>

		<div class="grid gap-6 lg:grid-cols-2">
			{
				t.groups.map((g) => (
					<article class="rounded-[6px] bg-gray-50 p-8">
						<h2 class="mb-6 border-l-[5px] border-primary-500 pl-4 text-2xl leading-8 font-semibold text-gray-900">
							{g.title}
						</h2>
						<dl class="flex flex-col gap-4">
							{g.items.map((i) => (
								<div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
									<dt class="shrink-0 text-base leading-6 font-semibold text-gray-900 sm:w-40">{i.label}</dt>
									<dd class="text-base leading-6 text-gray-700">{i.value}</dd>
								</div>
							))}
						</dl>
					</article>
				))
			}
		</div>

		<div class="flex flex-col gap-6">
			<h2 class="text-[32px] leading-10 font-semibold text-[#333]">{t.flowTitle}</h2>
			<ol class="flex flex-col gap-4">
				{
					t.steps.map((step, n) => (
						<li class="flex items-start gap-4">
							<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-500 text-sm font-semibold text-white">
								{n + 1}
							</span>
							<p class="pt-1 text-base leading-6 text-gray-700">{step}</p>
						</li>
					))
				}
			</ol>
		</div>

		<a
			href="/"
			class="inline-flex w-fit items-center justify-center rounded-[4px] border border-gray-100 px-6 py-3 text-base leading-6 font-semibold text-gray-700 transition-colors hover:text-primary-500"
		>
			← {t.back}
		</a>
	</div>
</section>
