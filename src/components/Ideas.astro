---
import { ui } from '../i18n/ui';
const t = ui[Astro.locals.lang].ideas;
---

<section id="ideas" class="flex flex-col items-center px-6 py-[100px] xl:px-0">
	<div class="mx-auto flex w-full max-w-[1320px] flex-col items-center gap-[70px]">
		<header class="flex flex-col items-center gap-6 text-center">
			<h2 class="text-[40px] leading-[48px] font-semibold text-gray-900 sm:text-5xl sm:leading-[56px]">{t.title}</h2>
			<p class="max-w-[660px] text-lg leading-6 text-gray-400">{t.subtitle}</p>
		</header>

		<ul class="grid w-full grid-cols-1 gap-6 md:grid-cols-2">
			{
				t.items.map((item, i) => (
					<li class="flex flex-col gap-4 rounded-lg border border-gray-100 border-t-4 border-t-primary-500 bg-white p-8 transition-shadow hover:shadow-[0px_12px_32px_0px_rgba(28,25,25,0.12)]">
						<span class="text-sm leading-5 font-semibold text-primary-500">{String(i + 1).padStart(2, '0')}</span>
						<h3 class="text-2xl leading-8 font-semibold text-gray-900">{item.title}</h3>
						<p class="text-base leading-6 text-gray-600">{item.description}</p>
						{item.tags.length > 0 && (
							<ul class="mt-auto flex flex-wrap gap-2 pt-2">
								{item.tags.map((tag) => (
									<li class="rounded-[4px] bg-primary-100 px-2.5 py-1 text-xs leading-4 font-medium text-gray-700">{tag}</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ul>

		<div class="flex flex-col items-center gap-6 text-center">
			<p class="max-w-[560px] text-lg leading-6 text-gray-500">{t.ctaText}</p>
			<a
				href="#contact"
				class="inline-flex items-center justify-center rounded-[4px] bg-primary-500 px-6 py-3 text-base leading-6 font-semibold whitespace-nowrap text-white transition-opacity hover:opacity-90"
				>{t.cta}</a
			>
		</div>
	</div>
</section>
