---
import { languages, ui, type Lang } from '../i18n/ui';

const lang = Astro.locals.lang;
const t = ui[lang].nav;
const links = t.links;
const langs = Object.keys(languages) as Lang[];
---

<header class="sticky top-0 z-50 border-b border-gray-50 bg-white/95 backdrop-blur">
	<div class="mx-auto flex max-w-[1320px] items-center justify-between px-6 py-2 xl:px-0">
		<a href="#home" class="flex items-center justify-center gap-3">
			<span
				class="flex size-10 items-center justify-center rounded-full bg-primary-500 font-logo text-[11px] leading-10 font-medium tracking-tight text-white"
				aria-hidden="true">D.C.A</span
			>
			<span class="text-lg leading-6 font-medium whitespace-nowrap text-gray-700">David Aviani</span>
		</a>

		<nav class="hidden items-center lg:flex" aria-label={t.main}>
			{
				links.map((l) => (
					<a
						href={l.href}
						class="px-3 py-2 text-base leading-6 font-medium whitespace-nowrap text-[#333] xl:px-6 transition-colors hover:text-primary-500"
					>
						{l.label}
					</a>
				))
			}
			<a
				href="#contact"
				class="rounded-[4px] bg-primary-500 px-5 py-2 text-base leading-6 font-semibold whitespace-nowrap text-white transition-opacity hover:opacity-90"
			>
				{t.contact}
			</a>
			<div class="ml-2 xl:ml-4 flex items-center rounded-[4px] border border-gray-100 p-0.5" role="group" aria-label={t.language}>
				{
					langs.map((l) => (
						<a
							href={`?lang=${l}`}
							data-lang={l}
							lang={l}
							title={languages[l]}
							aria-current={l === lang ? 'true' : undefined}
							class:list={[
								'rounded-[3px] px-2.5 py-1.5 text-sm leading-5 font-semibold uppercase transition-colors',
								l === lang ? 'bg-primary-500/10 text-primary-500' : 'text-gray-600 hover:text-primary-500',
							]}
						>
							{l}
						</a>
					))
				}
			</div>
		</nav>

		<button
			id="nav-toggle"
			type="button"
			class="flex size-10 items-center justify-center lg:hidden"
			aria-label={t.openMenu}
			aria-expanded="false"
			aria-controls="nav-mobile"
		>
			<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<path d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
		</button>
	</div>

	<nav
		id="nav-mobile"
		class="hidden max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-t border-gray-50 px-6 pb-5 lg:hidden"
		aria-label={t.mobile}
	>
		<ul class="flex flex-col">
			{
				links.map((l) => (
					<li>
						<a href={l.href} class="block py-3 text-base font-medium text-[#333]">
							{l.label}
						</a>
					</li>
				))
			}
			<li class="pt-2">
				<a
					href="#contact"
					class="inline-block rounded-[4px] bg-primary-500 px-6 py-3 text-base font-semibold text-white"
				>
					{t.contact}
				</a>
			</li>
			<li class="flex items-center gap-2 pt-4" role="group" aria-label={t.language}>
				{
					langs.map((l) => (
						<a
							href={`?lang=${l}`}
							data-lang={l}
							lang={l}
							aria-current={l === lang ? 'true' : undefined}
							class:list={[
								'rounded-[4px] border px-3 py-1.5 text-sm font-semibold',
								l === lang ? 'border-primary-500 bg-primary-500/10 text-primary-500' : 'border-gray-100 text-gray-600',
							]}
						>
							{languages[l]}
						</a>
					))
				}
			</li>
		</ul>
	</nav>
</header>

<script>
	document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) =>
		a.addEventListener('click', (event) => {
			event.preventDefault();
			document.cookie = `lang=${a.dataset.lang}; path=/; max-age=31536000; samesite=lax`;
			location.reload();
		}),
	);
	const btn = document.getElementById('nav-toggle');
	const menu = document.getElementById('nav-mobile');
	btn?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden') === false;
		btn.setAttribute('aria-expanded', String(open));
	});
	menu?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			menu.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
		}),
	);
</script>
