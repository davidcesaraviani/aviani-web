---
interface Props {
	title?: string;
	description?: string;
}
import '../styles/global.css';
import { ui } from '../i18n/ui';

const lang = Astro.locals.lang;
const meta = ui[lang].meta;
const { title = meta.title, description = meta.description } = Astro.props;

---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@500&family=Montserrat:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="David Aviani" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://aviani.com.ar/" />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_AR'} />
		<meta property="og:image" content="https://aviani.com.ar/og-image.jpg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://aviani.com.ar/og-image.jpg" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
